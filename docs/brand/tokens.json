{
  "$description": "Neverwas brand tokens v1.0 (2026-10-15). Source of truth for colour, type, spacing and radius; docs/brand/manual.html documents them.",
  "color": {
    "primary":           { "$type": "color", "$value": "#6656F0", "$description": "Brand colour: the tile of the symbol, accents, links on light surfaces. 5.05:1 on white." },
    "primary-strong":    { "$type": "color", "$value": "#4C3CCF", "$description": "Hover/pressed, primary text that needs AAA. 7.36:1 on white." },
    "primary-subtle":    { "$type": "color", "$value": "#EEECFE", "$description": "Selected rows, tinted backgrounds. Text on it: ink or primary-strong." },
    "primary-on-dark":   { "$type": "color", "$value": "#A298FF", "$description": "Primary for text and icons on ink. 7.28:1 on ink." },
    "ink":               { "$type": "color", "$value": "#17151F", "$description": "Body text on light; dark-theme background." },
    "ink-raised":        { "$type": "color", "$value": "#24212E", "$description": "Dark-theme raised surface." },
    "graphite":          { "$type": "color", "$value": "#3A3746", "$description": "Secondary text, icons." },
    "slate":             { "$type": "color", "$value": "#5F5C6D", "$description": "Muted text on light surfaces. 6.22:1 on paper." },
    "slate-on-dark":     { "$type": "color", "$value": "#A7A4B5", "$description": "Muted text on ink. 7.41:1." },
    "mist":              { "$type": "color", "$value": "#C9C7D3", "$description": "Dividers and decorative borders only (1.6:1 on paper: never text or essential UI borders)." },
    "fog":               { "$type": "color", "$value": "#ECEBF1", "$description": "Subtle backgrounds, table stripes." },
    "paper":             { "$type": "color", "$value": "#FAFAFC", "$description": "Default light background." },
    "white":             { "$type": "color", "$value": "#FFFFFF", "$description": "The N of the symbol; text on primary." },
    "success":           { "$type": "color", "$value": "#17784C", "$description": "Semantic, not brand. 5.49:1 on white." },
    "warning":           { "$type": "color", "$value": "#8A5800", "$description": "Semantic text/icon. 6.04:1 on white." },
    "warning-fill":      { "$type": "color", "$value": "#F4B740", "$description": "Semantic fill; text on it: ink (10.05:1)." },
    "danger":            { "$type": "color", "$value": "#C0302B", "$description": "Semantic. 5.68:1 on white. Never the brand colour." },
    "info":              { "$type": "color", "$value": "#1F6AAE", "$description": "Semantic. 5.63:1 on white." }
  },
  "font": {
    "family": {
      "brand": { "$type": "fontFamily", "$value": ["Manrope", "Segoe UI", "system-ui", "sans-serif"], "$description": "SIL OFL 1.1. Wordmark, headings, documentation, web." },
      "mono":  { "$type": "fontFamily", "$value": ["Cascadia Mono", "Cascadia Code", "Consolas", "monospace"], "$description": "SIL OFL 1.1 (GitHub release). neverwas-cli, code, paths." },
      "ui":    { "$type": "fontFamily", "$value": ["Segoe UI", "system-ui", "sans-serif"], "$description": "Inside the Windows app: the system face, not shipped by Neverwas." }
    },
    "size": {
      "small":   { "$type": "dimension", "$value": "13px" },
      "body":    { "$type": "dimension", "$value": "16px" },
      "body-l":  { "$type": "dimension", "$value": "20px" },
      "h3":      { "$type": "dimension", "$value": "25px" },
      "h2":      { "$type": "dimension", "$value": "31px" },
      "h1":      { "$type": "dimension", "$value": "39px" },
      "display": { "$type": "dimension", "$value": "49px" }
    },
    "weight": {
      "regular":  { "$type": "fontWeight", "$value": 400 },
      "semibold": { "$type": "fontWeight", "$value": 600 },
      "bold":     { "$type": "fontWeight", "$value": 700 }
    },
    "line-height": {
      "body":    { "$type": "number", "$value": 1.5 },
      "heading": { "$type": "number", "$value": 1.15 }
    }
  },
  "space": {
    "xxs": { "$type": "dimension", "$value": "4px" },
    "xs":  { "$type": "dimension", "$value": "8px" },
    "sm":  { "$type": "dimension", "$value": "16px" },
    "md":  { "$type": "dimension", "$value": "24px" },
    "lg":  { "$type": "dimension", "$value": "32px" },
    "xl":  { "$type": "dimension", "$value": "48px" },
    "2xl": { "$type": "dimension", "$value": "64px" },
    "3xl": { "$type": "dimension", "$value": "96px" }
  },
  "radius": {
    "sm":   { "$type": "dimension", "$value": "4px" },
    "md":   { "$type": "dimension", "$value": "8px" },
    "tile": { "$type": "number", "$value": 0.2143, "$description": "Symbol tile radius as a fraction of its side (3/14)." }
  }
}
